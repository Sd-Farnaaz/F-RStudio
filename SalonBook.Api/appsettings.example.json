{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DATABASE_SERVER;Database=YOUR_DATABASE_NAME;User Id=YOUR_USER_ID;Password=YOUR_DATABASE_PASSWORD;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "SecretKey": "YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "SalonBook",
    "Audience": "SalonBook.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "PasswordResetTokenExpirationMinutes": 30
  },
  "SuperAdmin": {
    "Email": "superadmin@example.com",
    "FullName": "Super Administrator",
    "Password": "YOUR_STRONG_SUPERADMIN_PASSWORD"
  },
  "Email": {
    "IsEnabled": false,
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "SmtpUsername": "YOUR_BREVO_SMTP_LOGIN",
    "SmtpPassword": "YOUR_BREVO_SMTP_KEY",
    "SenderEmail": "your-verified-sender@example.com",
    "SenderName": "F&R Beauty Studio",
    "EnableSsl": true
  },
  "Razorpay": {
    "KeyId": "rzp_test_YOUR_KEY_ID",
    "KeySecret": "YOUR_RAZORPAY_TEST_KEY_SECRET",
    "WebhookSecret": "YOUR_RAZORPAY_WEBHOOK_SECRET_OPTIONAL"
  }
}
